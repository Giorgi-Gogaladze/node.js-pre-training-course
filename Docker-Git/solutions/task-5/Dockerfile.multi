# stage 1 builder;
FROM node:24 AS builder

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

RUN npm run build

# stage 2 production;
FROM node:24-alpine AS production

WORKDIR /app

COPY package*.json ./
#says to install only production dependencies and omit dev dependencies
RUN npm install --omit=dev

#copy compiled JavaScript from builder
COPY --from=builder /app/dist ./dist

CMD ["node", "dist/index.js"]


