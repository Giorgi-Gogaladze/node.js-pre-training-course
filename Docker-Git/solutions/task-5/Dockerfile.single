
#base image
FROM node:24

#setting the  working directory
WORKDIR /app

#copy package files
COPY package*.json ./

#install all dependencies
RUN npm install

#copy project files
COPY . .

#compiling ts
RUN npm run build

#starting application
CMD ["node", "dist/index.js"]



